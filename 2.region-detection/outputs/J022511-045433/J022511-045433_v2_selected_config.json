{
  "selection": {
    "analysis_half_size_pix": 30,
    "min_area_pix": 5,
    "subtract_lens_region_from_source": true,
    "ranking": "area * (1 - point_symmetric_overlap_fraction)^2"
  },
  "sextractor": {
    "lens": {
      "input_mode": "snr",
      "detect_snr_floor": 3.0,
      "detect_peak_fraction": 0.35,
      "detect_minarea": 5,
      "deblend_nthresh": 32,
      "deblend_mincont": 0.001,
      "back_size": 16
    },
    "source": {
      "input_mode": "snr",
      "detect_snr_floor": 6.0,
      "detect_peak_fraction": 0.0,
      "detect_minarea": 5,
      "deblend_nthresh": 32,
      "deblend_mincont": 0.001,
      "back_size": 16
    }
  }
}
