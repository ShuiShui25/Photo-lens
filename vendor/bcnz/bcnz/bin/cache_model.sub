# Example submission file running with HTCondor.
# This should only be considered a template!
#
# Supply bcnz_python, bcnz_cache_script and bcnz_model_dir with condor_submit.
Executable = $(bcnz_python)
arguments = "'$(bcnz_cache_script)' '$(bcnz_model_dir)' $(model)"

error   = err.$(Process)
output  = out.$(Process)

queue model from seq 0 34 |
